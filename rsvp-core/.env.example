# Copy to .env in this same folder and fill in real values.
# .env must never be committed to version control.

# Local XAMPP: http://localhost/packagewithsense_forms
# Production (dropped into the WP root): https://packagewithsense.com
PWS_SITE_URL=http://localhost/packagewithsense_forms

PWS_DB_HOST=localhost
PWS_DB_NAME=packagewithsense_rsvp
PWS_DB_USER=root
PWS_DB_PASS=

# Generate with: php -r "echo bin2hex(random_bytes(24));"
SYNC_API_KEY=CHANGE_ME_32_CHAR_RANDOM_STRING

# Shared secret for the GitHub push webhook (deploy.php). Must match the
# secret configured on the GitHub webhook. Server-only; generate with:
#   php -r "echo bin2hex(random_bytes(24));"
DEPLOY_SECRET=CHANGE_ME_WEBHOOK_SECRET

# Set to 1 to also display PHP errors on-screen while developing locally.
# Leave unset/0 in production — errors still get logged to rsvp-core/logs/php-error.log either way.
PWS_DEBUG=0
